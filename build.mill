//| mill-version: 1.1.8
//| mill-jvm-version: 21
//| mvnDeps:
//| - com.lihaoyi::mill-contrib-scoverage:$MILL_VERSION
//| - com.lihaoyi::mill-contrib-sonatypecentral:$MILL_VERSION
//| - com.lihaoyi::mill-contrib-jmh:$MILL_VERSION
//| - org.scala-steward::scala-steward-mill-plugin::0.19.0
package build

import mill.*
import mill.scalalib.*
import mill.scalalib.publish.*
import mill.scalajslib.*
import mill.scalanativelib.*
import mill.contrib.scoverage.ScoverageModule
import mill.contrib.jmh.JmhModule
import mill.util.VcsVersion

object `package` extends Module:

  trait Shared extends ScalaModule with PlatformScalaModule with SonatypeCentralPublishModule:
    def scalaVersion = "3.9.0"

    override def scalacOptions = Seq(
      "-deprecation",
      "-feature",
      "-new-syntax",
      "-unchecked",
      "-language:noAutoTupling",
      "-Vprofile",
      "-Xprint-inline",
      "-Xcheck-macros",
      "-Ycheck:macros",
      "-Ydebug-flags",
      "-Ydebug-missing-refs",
      "-Yexplain-lowlevel",
      "-Yexplicit-nulls",
      "-Yshow-suppressed-errors",
      "-Yshow-var-bounds",
      "-Wsafe-init",
      "-Werror",
      "-Wunused:all",
      // -Ycheck:all can't be enabled once Scoverage instruments the trees (same
      // limitation alpaca hit); -Ycheck:macros above stays.
      "-Wconf:msg=Skipping coverage instrumentation.*:s",
    )

    override def scalaDocOptions = Task {
      Seq(
        "-project",
        "regex",
        "-project-version",
        publishVersion(),
        "-project-footer",
        "made with ❤️ and coffee",
        "-social-links:github::https://github.com/halotukozak/regex",
        "-snippet-compiler:compile",
        s"-source-links:$moduleDir=github://halotukozak/regex/main",
        "-revision:main",
      )
    }

    def artifactName = "regex"

    def publishVersion = Task(VcsVersion.vcsState().format())

    def pomSettings = PomSettings(
      description =
        "A pure-Scala symbolic regex algebra with exact language containment (subset) checks, cross-built for JVM, Scala.js, and Scala Native",
      organization = "com.halotukozak",
      url = "https://github.com/halotukozak/regex",
      licenses = Seq(License.MIT),
      versionControl = VersionControl.github("halotukozak", "regex"),
      developers = Seq(Developer("halotukozak", "Bartłomiej Kozak", "https://github.com/halotukozak")),
    )

    def mvnDeps = Seq(mvn"com.halotukozak::commons::0.1.2")

  object jvm extends Shared with ScoverageModule:
    def scoverageVersion = "2.5.2"

    object test extends ScalaTests with TestModule.Munit with ScoverageTests:
      def munitVersion = "1.3.5"

  object js extends Shared with ScalaJSModule:
    def scalaJSVersion = "1.22.0"

    object test extends ScalaJSTests with TestModule.Munit:
      def munitVersion = "1.3.5"

  object native extends Shared with ScalaNativeModule:
    def scalaNativeVersion = "0.5.12"

    object test extends ScalaNativeTests with TestModule.Munit:
      def munitVersion = "1.3.5"

  // JMH benchmarks — JVM-only, never published. See bench/README.md.
  object bench extends ScalaModule with JmhModule:
    def scalaVersion = build.jvm.scalaVersion()
    def jmhCoreVersion = "1.37"
    def moduleDeps = Seq(build.jvm)
    override def scalacOptions = build.jvm.scalacOptions()

  // One-off codegen for src/UnicodeCategories.scala from the host JDK — JVM-only,
  // never published. Run: ./mill scripts.runMain halotukozak.regex.genUnicodeCategories
  object scripts extends ScalaModule:
    def scalaVersion = build.jvm.scalaVersion()
    def moduleDeps = Seq(build.jvm)
    override def scalacOptions = build.jvm.scalacOptions()
